    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0434\u043B\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0430\u0440\u0446\u0438\u0438
    \u0432\u0430\u043C \u043D\u0430\u0434\u043E \u0441\u043A\u0430\u0447\u0430\u0442\u044C
    \u0433\u0438\u0442 \u0445\u0430\u0431 \u0441\u043E\u0434\u0430\u0442\u044C \u0440\u0435\u043F\u043E\u0437\u0438\u0442\u043E\u0440\u0438\u0439
    \u0441 \u0438\u043C\u0435\u043D\u0435\u043C YourAcount \u0437\u0430\u043A\u0443\u043D\u0443\u0442\u044C
    \u0442\u0443\u0434\u0430 \u0444\u0430\u0439\u043B\u044B \u0438\u0437 \u043F\u0430\u043F\u043A\u0438
    res/UserWorckspace/web/YourAcount \u0432 \u043F\u0430\u043A\u0443 \u043F\u0440\u043E\u044D\u043A\u0442\u0430
    \u0433\u0438\u0442\u0445\u0430\u0431\u0430 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C
    \u0443\u0431\u0430\u0432 \u0433\u0430\u043B\u043E\u0447\u043A\u0443 \u043F\u0440\u0438
    \u043F\u0443\u0448\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u044B\u043C
    \u0437\u0430\u0439\u0442\u0438 \u043D\u0430 \u0433\u0438\u0442 \u0445\u0430\u0431
    \u0441\u0430\u0439\u0442 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0432\u0430\u043D\u044B\u0439
    \u0432\u0430\u043C\u0438 \u0447\u0435\u0437\u0435 \u043D\u0435\u0433\u043E\u0432\u043E\u0439\u0442\u0438
    \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430
    \u0438 \u043D\u0430\u0434\u0430\u0442\u044C \u043D\u0430 \u0432\u044B\u0431\u043E\u0440
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0433\u0438\u0442 \u0445\u0430\u0431
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043F\u0430\u043A\u0435\u0442 \u0434\u043B\u044F \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0441\u0432\u0439\u0442\u0430
    \u043D\u0430 html \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0432 \u043F\u043E\u043B\u0435
    \u0430\u043A\u0430\u0443\u043D\u0442\u0430 \u0438\u043C\u044F \u0432 git hub"
