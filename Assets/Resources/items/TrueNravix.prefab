  m_text: "\u0442\u044B \u043E\u0447\u0435\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u043E
    \u043C\u0438\u043C\u0438\u043A\u0440\u0438\u0443\u0435\u0448\u044C \u043F\u043E\u0434
    \u043C\u0435\u043D\u044F \u0438\u0433\u0440\u043E\u043A \u0442\u043E\u043B\u044C\u043A\u043E
    \u044F \u0442\u0435\u0431\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E
    \u043F\u043E\u043A\u0430\u0442\u044B \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u0442
    \u0431\u0443\u0434\u0443 \u0442\u0430\u0431\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0437\u0430\u0431\u0443\u0442\u044C \u044D\u0442\u043E \u043C\u043E\u0439 \u043C\u0438\u0440
    \u043C\u043E\u044F \u0444\u0430\u0442\u0430\u0437\u0438\u044F \u043C\u043E\u0438
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430! \u0442\u044B \u043E\u0447\u0435\u043D\u044C
    \u0441\u0445\u043E\u0436 \u0441\u043E\u043C\u043D\u043E\u0439 \u043D\u043E \u0442\u044B
    \u0432\u0441\u0451 \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E \u043D\u043E
    \u043D\u0435 \u044F! \u0442\u044B \u0441\u0445\u043E\u0436 \u0441\u043E\u043C\u043D\u043E\u0439
    \u043F\u043E\u0442\u043E\u043C\u0443\u0447\u0442\u043E \u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0447\u0438\u043A
    \u0438\u0433\u0440\u0430!"
